# =============================================================================
# Diabetes Risk Intelligence — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon Postgres — https://neon.tech)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Clerk Auth (https://dashboard.clerk.com)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# -----------------------------------------------------------------------------
# Upstash Redis (rate limiting — https://console.upstash.com)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# -----------------------------------------------------------------------------
# ML Model
# -----------------------------------------------------------------------------
MODEL_PATH=models/diabetes_rf.joblib

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# AI Assistant provider (optional — for the AI chat/explanation features)
# Pick a FREE LLM provider and paste its API key.
# -----------------------------------------------------------------------------
AI_PROVIDER=qwen            # one of: qwen | deepseek | kimi | siliconflow | openai
AI_API_KEY=                 # your FREE key from the provider below

# Where to get a FREE key:
#   qwen       -> https://dashscope.console.aliyun.com  (free monthly quota)  [DEFAULT]
#   deepseek   -> https://platform.deepseek.com  (free trial credits)
#   kimi       -> https://platform.moonshot.cn  (free tier)
#   siliconflow-> https://siliconflow.cn  (free quota, many models)

# Optional overrides:
# AI_MODEL=deepseek-chat        # model name (defaults per provider above)
# OPENAI_API_KEY=               # also accepted instead of AI_API_KEY
