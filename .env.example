# =============================================================================
# Diabetes Risk Intelligence — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon Postgres — https://neon.tech)
# Optional in local development: leave blank to run in stateless mode
# (screenings are computed but not persisted server-side).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Clerk Auth (https://dashboard.clerk.com)
# Leave blank locally to run without auth.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Clerk -> Neon user-sync webhook signing secret (svix). Endpoint:
#   POST {API_URL}/api/v1/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# Vercel Cron protection. Vercel sends this as `Authorization: Bearer <secret>`
# to /api/v1/cron/sync-devices. Leave blank to disable the check locally.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Local development only — bypass Clerk auth with a fixed user.
# NEVER enable in production.
# -----------------------------------------------------------------------------
DEV_AUTH_BYPASS=false
DEV_USER_ID=dev-user

# Frontend -> API base URL (used by the Next.js app)
# Local dev: the FastAPI dev server. In production this can be LEFT BLANK so the
# frontend calls the API on the same origin (Vercel Services publishes it under
# /api/v1); the client falls back to same-origin automatically when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Python runtime for the Vercel Python function. Pin to the version the ML
# artifacts were trained with to avoid pickle/ABI surprises.
PYTHON_VERSION=3.11

# -----------------------------------------------------------------------------
# Upstash Redis (rate limiting — https://console.upstash.com)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# -----------------------------------------------------------------------------
# ML Model
# -----------------------------------------------------------------------------
MODEL_PATH=data/processed/best_model.joblib

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# -----------------------------------------------------------------------------
# AI Assistant provider (optional — for the AI chat/explanation features)
# Pick a FREE LLM provider and paste its API key.
# -----------------------------------------------------------------------------
AI_PROVIDER=qwen            # one of: qwen | deepseek | kimi | siliconflow | openai
AI_API_KEY=                 # your FREE key from the provider below

# Where to get a FREE key:
#   qwen       -> https://dashscope.console.aliyun.com  (free monthly quota)  [DEFAULT]
#   deepseek   -> https://platform.deepseek.com  (free trial credits)
#   kimi       -> https://platform.moonshot.cn  (free tier)
#   siliconflow-> https://siliconflow.cn  (free quota, many models)

# Optional overrides:
# AI_MODEL=deepseek-chat        # model name (defaults per provider above)
# OPENAI_API_KEY=               # also accepted instead of AI_API_KEY
