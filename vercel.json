{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "app/",
      "framework": "nextjs"
    },
    "api": {
      "root": "api/python/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/sync-devices",
      "schedule": "0 6 * * *"
    }
  ]
}
